<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="mx.unam.musicdb.controller.MainController"
            stylesheets="@../css/main.css">

    <top>
        <VBox styleClass="header">
            <Label text="MusicDB" styleClass="titulo-app"/>
            <HBox styleClass="barra-busqueda" spacing="10">
                <TextField fx:id="campoBusqueda"
                           promptText="titulo:love,genero:rock | performer:queen | anio>=1990"
                           HBox.hgrow="ALWAYS"/>
                <Button text="Buscar"      onAction="#buscar"      styleClass="btn-primario"/>
                <Button text="Ver todas"   onAction="#cargarTodas" styleClass="btn-secundario"/>
                <Button text="Importar MP3" onAction="#importarMP3" styleClass="btn-importar"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <TableView fx:id="tablaRolas" styleClass="tabla-canciones">
            <columns>
                <TableColumn fx:id="colId"        text="ID"        prefWidth="50"/>
                <TableColumn fx:id="colTitulo"    text="Título"    prefWidth="200"/>
                <TableColumn fx:id="colPerformer" text="Performer" prefWidth="100"/>
                <TableColumn fx:id="colAlbum"     text="Álbum"     prefWidth="100"/>
                <TableColumn fx:id="colTrack"     text="Track"     prefWidth="60"/>
                <TableColumn fx:id="colAnio"      text="Año"       prefWidth="70"/>
                <TableColumn fx:id="colGenero"    text="Género"    prefWidth="120"/>
            </columns>
            <placeholder>
                <Label text="No hay rolas. Ejecuta el minero para importar archivos MP3."/>
            </placeholder>
        </TableView>
    </center>

    <bottom>
        <HBox styleClass="status-bar">
            <Label fx:id="etiquetaEstado" text="Listo"/>
        </HBox>
    </bottom>

</BorderPane>
